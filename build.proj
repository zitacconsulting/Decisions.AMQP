<?xml version="1.0" encoding="utf-8"?>
<Project
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0" DefaultTargets="build_all">

    <Target Name="build_all">
        <Exec Command="dotnet publish ./Decisions.AMQP/Decisions.AMQP.csproj --self-contained false --output ./Decisions.AMQP/bin -c Debug" />
        <Exec Command="dotnet tool update --global CreateDecisionsModule-GlobalTool" />
        <CallTarget Targets="build_module"/>
    </Target>

    <Target Name="build_module">
        <!-- CreateDecisionsModule truncates ModuleName to everything before the LAST "." of
             -buildmodule's argument ("Decisions.AMQP" would become "Decisions").
             The throwaway ".Module" suffix makes ModuleName the intended "Decisions.AMQP",
             which must match AmqpQueueSettings.MODULE_NAME. -->
        <Exec Command="CreateDecisionsModule -buildmodule Decisions.AMQP.Module -output &quot;.&quot; -buildfile Module.Build.json"/>
        <Move SourceFiles="Decisions.AMQP.Module.zip" DestinationFiles="Decisions.AMQP.zip" />
    </Target>

</Project>
